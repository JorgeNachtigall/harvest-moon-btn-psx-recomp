# ---------------------------------------------------------------------------
# Copyrighted game data. You supply these from your own legally-obtained disc;
# they are never distributed with this repository.
# ---------------------------------------------------------------------------
*.bin
*.cue
*.img
*.iso
*.chd
SLUS_011.15
SLUS_011.15.text.bin

# Recompiled game C is derived from the copyrighted executable — build output,
# never tracked. Regenerate with tools/regen.sh.
generated/

# Compiled overlay shared objects are likewise derived from game code.
cache/

# Overlay captures contain verbatim game code bytes.
overlay_captures.json
overlay_captures.addendum.jsonl
overlay_captures.json.d/
captures/

# Build trees
build/

# Runtime state
*.mcr
*.mcd
saves/
settings.toml
disc.cfg
bios.cfg
psx_screenshot*.png

# tools/extract_overlays.py imports extract_psx_exe as a module
__pycache__/

# Packaged .app bundles embed your disc image. Personal backups of your own
# disc for your own machines — never redistributed, never tracked.
dist/

# macOS
.DS_Store
psx_last_run_report.json

# Runtime diagnostic dumps
starvation_dump.jsonl

# Crash/freeze post-mortems the runtime drops in the working directory.
psx_crash.txt
psx_freeze_dump_*.json
